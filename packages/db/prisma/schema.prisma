generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  isAdmin             Boolean           @default(false)
  isVerified          Boolean           @default(false)
  verificationBadge   String?
  reputation          Int               @default(0)
  trustLevel          String            @default("new")
  bio                 String?
  phoneNumber         String?
  phoneVerified       Boolean           @default(false)
  website             String?
  location            String?
  joinedAt            DateTime          @default(now())
  lastActiveAt        DateTime          @default(now())
  showEmail           Boolean           @default(false)
  showPhone           Boolean           @default(false)
  showLocation        Boolean           @default(true)
  lastLoginAt         DateTime?
  lastPasswordChange  DateTime?
  password            String?
  passwordResetExpiry DateTime?
  passwordResetToken  String?
  averageRating       Float             @default(0)
  totalRatings        Int               @default(0)
  Account             Account[]
  blogPosts           BlogPost[]
  brandAudits         BrandAudit[]
  approvedBrands      Brand[]           @relation("BrandApprovals")
  createdBrands       Brand[]           @relation("BrandCreators")
  submittedBrands     Brand[]           @relation("BrandSubmissions")
  updatedBrands       Brand[]           @relation("BrandUpdaters")
  comments            Comment[]
  buyerConversations  Conversation[]    @relation("BuyerConversations")
  sellerConversations Conversation[]    @relation("SellerConversations")
  files               File[]
  foundItems          FoundItem[]
  listings            Listing[]
  lostReports         LostReport[]
  matches             Match[]
  messages            Message[]
  modelAudits         ModelAudit[]
  approvedModels      Model[]           @relation("ModelApprovals")
  createdModels       Model[]           @relation("ModelCreators")
  submittedModels     Model[]           @relation("ModelSubmissions")
  updatedModels       Model[]           @relation("ModelUpdaters")
  offers              Offer[]
  orders              Order[]
  sellerOrders        Order[]           @relation("SellerOrders")
  reviewedBrands      ProposedBrand[]   @relation("AdminBrandReviews")
  proposedBrands      ProposedBrand[]   @relation("UserProposedBrands")
  reviewedModels      ProposedModel[]   @relation("AdminModelReviews")
  proposedModels      ProposedModel[]   @relation("UserProposedModels")
  ratings             Rating[]
  savedSearches       SavedSearch[]     @relation("UserSavedSearches")
  searchAnalytics     SearchAnalytics[] @relation("UserSearchAnalytics")
  Session             Session[]
  SurveyResponse      SurveyResponse[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Brand {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  description     String?
  logo            String?
  website         String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  metaTitle       String?
  metaDescription String?
  approvedAt      DateTime?
  approvedBy      String?
  isVerified      Boolean          @default(false)
  rejectionReason String?
  status          BrandStatus      @default(PENDING)
  submittedBy     String?
  createdBy       String?
  updatedBy       String?
  blogPosts       BlogPost[]
  auditHistory    BrandAudit[]
  approver        User?            @relation("BrandApprovals", fields: [approvedBy], references: [id])
  creator         User?            @relation("BrandCreators", fields: [createdBy], references: [id])
  submitter       User?            @relation("BrandSubmissions", fields: [submittedBy], references: [id])
  updater         User?            @relation("BrandUpdaters", fields: [updatedBy], references: [id])
  FoundItem       FoundItem[]
  Listing         Listing[]
  LostReport      LostReport[]
  models          Model[]
  proposedModels  ProposedModel[]
  Rating          Rating[]
  SponsoredLink   SponsoredLink[]
  SurveyResponse  SurveyResponse[]

  @@map("brands")
}

model ProposedBrand {
  id              String      @id @default(cuid())
  name            String      @unique
  description     String?
  website         String?
  submittedBy     String
  submissionNote  String?
  adminNote       String?
  status          BrandStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  reviewer        User?       @relation("AdminBrandReviews", fields: [reviewedBy], references: [id])
  submitter       User        @relation("UserProposedBrands", fields: [submittedBy], references: [id])

  @@map("proposed_brands")
}

model Model {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  brandId          String
  description      String?
  image            String?
  releaseDate      DateTime?
  discontinuedAt   DateTime?
  isActive         Boolean          @default(true)
  hasANC           Boolean          @default(false)
  batteryLife      Int?
  caseChargeTime   Int?
  earbudChargeTime Int?
  waterResistance  String?
  bluetoothVersion String?
  codecs           String[]
  driverSize       Int?
  frequency        String?
  impedance        Int?
  sensitivity      Int?
  earbudWeight     Float?
  caseWeight       Float?
  earbudDimensions String?
  caseDimensions   String?
  originalPrice    Decimal?         @db.Decimal(10, 2)
  currentPrice     Decimal?         @db.Decimal(10, 2)
  currency         String           @default("USD")
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  approvedAt       DateTime?
  approvedBy       String?
  isVerified       Boolean          @default(false)
  rejectionReason  String?
  status           ModelStatus      @default(PENDING)
  submittedBy      String?
  createdBy        String?
  updatedBy        String?
  blogPosts        BlogPost[]
  foundItems       FoundItem[]
  listings         Listing[]
  lostReports      LostReport[]
  auditHistory     ModelAudit[]
  approver         User?            @relation("ModelApprovals", fields: [approvedBy], references: [id])
  brand            Brand            @relation(fields: [brandId], references: [id])
  creator          User?            @relation("ModelCreators", fields: [createdBy], references: [id])
  submitter        User?            @relation("ModelSubmissions", fields: [submittedBy], references: [id])
  updater          User?            @relation("ModelUpdaters", fields: [updatedBy], references: [id])
  ratings          Rating[]
  SponsoredLink    SponsoredLink[]
  SurveyResponse   SurveyResponse[]

  @@unique([brandId, name])
  @@map("models")
}

model ProposedModel {
  id               String      @id @default(cuid())
  name             String
  brandId          String
  description      String?
  submittedBy      String
  submissionNote   String?
  adminNote        String?
  hasANC           Boolean?
  batteryLife      Int?
  waterResistance  String?
  bluetoothVersion String?
  originalPrice    Decimal?    @db.Decimal(10, 2)
  status           ModelStatus @default(PENDING)
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  brand            Brand       @relation(fields: [brandId], references: [id])
  reviewer         User?       @relation("AdminModelReviews", fields: [reviewedBy], references: [id])
  submitter        User        @relation("UserProposedModels", fields: [submittedBy], references: [id])

  @@unique([brandId, name])
  @@map("proposed_models")
}

model BrandAudit {
  id        String   @id @default(cuid())
  brandId   String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())
  notes     String?
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [changedBy], references: [id])

  @@map("brand_audits")
}

model ModelAudit {
  id        String   @id @default(cuid())
  modelId   String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())
  notes     String?
  user      User     @relation(fields: [changedBy], references: [id])
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("model_audits")
}

model City {
  id          String       @id @default(cuid())
  geoDbId     Int          @unique
  name        String
  country     String
  countryCode String
  region      String?
  regionCode  String?
  latitude    Decimal      @db.Decimal(10, 8)
  longitude   Decimal      @db.Decimal(11, 8)
  population  Int?
  timezone    String?
  displayName String
  searchText  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  foundItems  FoundItem[]
  listings    Listing[]
  lostReports LostReport[]

  @@index([searchText])
  @@index([countryCode])
  @@map("cities")
}

model Listing {
  id                String         @id @default(cuid())
  title             String
  description       String
  type              ListingType
  condition         Condition
  price             Decimal        @db.Decimal(10, 2)
  currency          String         @default("USD")
  status            ListingStatus  @default(DRAFT)
  brandId           String
  modelId           String
  serialNumber      String?
  identifierMasked  String?
  identifierFull    String?
  isVerified        Boolean        @default(false)
  cityId            String
  hideExactLocation Boolean        @default(true)
  latitude          Decimal?       @db.Decimal(10, 8)
  longitude         Decimal?       @db.Decimal(11, 8)
  images            String[]
  verificationPhoto String?
  sellerId          String
  sellerNotes       String?
  views             Int            @default(0)
  favorites         Int            @default(0)
  reportCount       Int            @default(0)
  boost             Boolean        @default(false)
  boostExpiresAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  publishedAt       DateTime?
  expiresAt         DateTime?
  soldAt            DateTime?
  customBrand       String?
  customModel       String?
  hasChargingCase   Boolean?
  hasLeftEarbud     Boolean?
  hasRightEarbud    Boolean?
  needsChargingCase Boolean?
  needsLeftEarbud   Boolean?
  needsRightEarbud  Boolean?
  openToAlternate   Boolean        @default(false)
  primaryIntent     ListingIntent  @default(SELLING)
  conversations     Conversation[]
  files             File[]
  FoundItem         FoundItem?
  brand             Brand          @relation(fields: [brandId], references: [id])
  city              City           @relation(fields: [cityId], references: [id])
  model             Model          @relation(fields: [modelId], references: [id])
  seller            User           @relation(fields: [sellerId], references: [id])
  matches           Match[]
  orders            Order[]

  @@index([status, publishedAt])
  @@index([brandId, modelId])
  @@index([cityId])
  @@index([type, condition])
  @@index([primaryIntent, openToAlternate])
  @@map("listings")
}

model LostReport {
  id                 String           @id @default(cuid())
  title              String
  description        String
  type               ListingType
  status             LostReportStatus @default(ACTIVE)
  brandId            String
  modelId            String
  serialNumber       String?
  identifierMasked   String?
  identifierFull     String?
  lostDate           DateTime
  lostLocation       String
  circumstances      String?
  cityId             String
  shareExactLocation Boolean          @default(false)
  latitude           Decimal?         @db.Decimal(10, 8)
  longitude          Decimal?         @db.Decimal(11, 8)
  searchRadius       Int              @default(50)
  rewardAmount       Decimal?         @db.Decimal(10, 2)
  rewardCurrency     String           @default("USD")
  rewardDescription  String?
  images             String[]
  proofOfPurchase    String?
  additionalEvidence String?
  reporterId         String
  contactEmail       String?
  contactPhone       String?
  preferredContact   String           @default("email")
  shareContact       Boolean          @default(false)
  allowPublicView    Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resolvedAt         DateTime?
  expiresAt          DateTime?
  brand              Brand            @relation(fields: [brandId], references: [id])
  city               City             @relation(fields: [cityId], references: [id])
  model              Model            @relation(fields: [modelId], references: [id])
  reporter           User             @relation(fields: [reporterId], references: [id])
  matches            Match[]

  @@index([status, lostDate])
  @@index([brandId, modelId])
  @@index([cityId])
  @@map("lost_reports")
}

model FoundItem {
  id                   String          @id @default(cuid())
  title                String
  description          String
  type                 ListingType
  status               FoundItemStatus @default(REPORTED)
  brandId              String
  modelId              String
  serialNumber         String?
  identifierMasked     String?
  identifierFull       String?
  condition            Condition
  foundDate            DateTime
  foundLocation        String
  circumstances        String?
  cityId               String
  latitude             Decimal?        @db.Decimal(10, 8)
  longitude            Decimal?        @db.Decimal(11, 8)
  jurisdiction         Jurisdiction
  authorityReported    Boolean         @default(false)
  authorityName        String?
  authorityContact     String?
  reportedAt           DateTime?
  waitingPeriodDays    Int
  availableForSaleAt   DateTime?
  authorityEvidence    String?
  legalDisclaimer      String?
  complianceNotes      String?
  finderId             String
  finderContactEmail   String?
  finderContactPhone   String?
  claimDeadline        DateTime?
  claimRequirements    String?
  images               String[]
  foundEvidence        String[]
  listingPrice         Decimal?        @db.Decimal(10, 2)
  listingCurrency      String          @default("USD")
  convertedToListingAt DateTime?
  listingId            String?         @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  claimedAt            DateTime?
  soldAt               DateTime?
  brand                Brand           @relation(fields: [brandId], references: [id])
  city                 City            @relation(fields: [cityId], references: [id])
  finder               User            @relation(fields: [finderId], references: [id])
  listing              Listing?        @relation(fields: [listingId], references: [id])
  model                Model           @relation(fields: [modelId], references: [id])
  Match                Match[]

  @@index([status, foundDate])
  @@index([jurisdiction, status])
  @@index([brandId, modelId])
  @@map("found_items")
}

model Match {
  id               String      @id @default(cuid())
  type             MatchType
  status           MatchStatus @default(PENDING)
  confidenceScore  Float
  identifierMatch  Boolean     @default(false)
  locationMatch    Boolean     @default(false)
  timelineMatch    Boolean     @default(false)
  descriptionMatch Boolean     @default(false)
  matchReason      String?
  algorithmVersion String      @default("1.0")
  lostReportId     String?
  listingId        String?
  foundItemId      String?
  userId           String
  createdAt        DateTime    @default(now())
  reviewedAt       DateTime?
  expiresAt        DateTime?
  foundItem        FoundItem?  @relation(fields: [foundItemId], references: [id])
  listing          Listing?    @relation(fields: [listingId], references: [id])
  lostReport       LostReport? @relation(fields: [lostReportId], references: [id])
  user             User        @relation(fields: [userId], references: [id])

  @@index([type, status])
  @@index([confidenceScore])
  @@map("matches")
}

model Rating {
  id                 String    @id @default(cuid())
  overallScore       Float
  comfort            Int?
  autonomy           Int?
  caseReloadTime     Int?
  earbudReloadTime   Int?
  musicQuality       Int?
  videoQuality       Int?
  gameQuality        Int?
  avLag              Int?
  callOverall        Int?
  callCoworking      Int?
  callStreet         Int?
  callBike           Int?
  title              String?
  comment            String?
  pros               String?
  cons               String?
  usageDuration      String?
  primaryUse         String[]
  isModerated        Boolean   @default(false)
  isApproved         Boolean   @default(false)
  moderationNotes    String?
  isSpam             Boolean   @default(false)
  userId             String?
  guestEmail         String?
  guestName          String?
  isVerifiedPurchase Boolean   @default(false)
  brandId            String
  modelId            String
  helpfulCount       Int       @default(0)
  notHelpfulCount    Int       @default(0)
  reportCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  moderatedAt        DateTime?
  brand              Brand     @relation(fields: [brandId], references: [id])
  model              Model     @relation(fields: [modelId], references: [id])
  user               User?     @relation(fields: [userId], references: [id])

  @@index([brandId, modelId, isApproved])
  @@index([overallScore])
  @@index([createdAt])
  @@map("ratings")
}

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String
  status          PostStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  featuredImage   String?
  tags            String[]
  category        String?
  brandId         String?
  modelId         String?
  authorId        String
  readTime        Int        @default(5)
  views           Int        @default(0)
  likes           Int        @default(0)
  commentCount    Int        @default(0)
  shareCount      Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  author          User       @relation(fields: [authorId], references: [id])
  brand           Brand?     @relation(fields: [brandId], references: [id])
  model           Model?     @relation(fields: [modelId], references: [id])
  comments        Comment[]

  @@index([status, publishedAt])
  @@index([brandId, modelId])
  @@index([tags])
  @@map("blog_posts")
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  userId      String?
  guestEmail  String?
  guestName   String?
  isModerated Boolean   @default(false)
  isApproved  Boolean   @default(false)
  isSpam      Boolean   @default(false)
  parentId    String?
  postId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
  post        BlogPost  @relation(fields: [postId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([postId, isApproved])
  @@index([parentId])
  @@map("comments")
}

model Conversation {
  id        String             @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  buyer     User               @relation("BuyerConversations", fields: [buyerId], references: [id])
  listing   Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller    User               @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]
  offers    Offer[]

  @@unique([listingId, buyerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    MessageType  @default(TEXT)
  attachments    Json?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Offer {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("USD")
  message        String?
  status         OfferStatus  @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("offers")
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  listingId        String
  buyerId          String
  sellerId         String
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  paymentMethod    PaymentMethod @default(PAYPAL)
  status           OrderStatus   @default(CREATED)
  paypalOrderId    String?
  paypalPayerId    String?
  paypalPaymentId  String?
  escrowHeld       Boolean       @default(false)
  escrowReleasedAt DateTime?
  notes            String?
  cancelReason     String?
  refundReason     String?
  disputeReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  approvedAt       DateTime?
  capturedAt       DateTime?
  cancelledAt      DateTime?
  refundedAt       DateTime?
  buyer            User          @relation(fields: [buyerId], references: [id])
  listing          Listing       @relation(fields: [listingId], references: [id])
  seller           User          @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@map("orders")
}

model SponsoredLink {
  id           String        @id @default(cuid())
  title        String
  description  String?
  url          String
  imageUrl     String?
  type         SponsoredType
  placement    PlacementType
  brandId      String?
  modelId      String?
  keywords     String[]
  countries    String[]
  isActive     Boolean       @default(true)
  startDate    DateTime?
  endDate      DateTime?
  budget       Decimal?      @db.Decimal(10, 2)
  costPerClick Decimal?      @db.Decimal(10, 4)
  impressions  Int           @default(0)
  clicks       Int           @default(0)
  conversions  Int           @default(0)
  revenue      Decimal       @default(0) @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  brand        Brand?        @relation(fields: [brandId], references: [id])
  model        Model?        @relation(fields: [modelId], references: [id])

  @@index([type, placement, isActive])
  @@index([brandId, modelId])
  @@map("sponsored_links")
}

model SavedSearch {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  filters              String
  alertsEnabled        Boolean   @default(false)
  lastNotificationSent DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation("UserSavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alertsEnabled])
  @@map("saved_searches")
}

model SearchAnalytics {
  id                String   @id @default(cuid())
  searchId          String   @unique
  query             String?
  filters           String
  userId            String?
  timestamp         DateTime @default(now())
  resultsCount      Int
  searchDuration    Int
  clickedListingIds String[]
  user              User?    @relation("UserSearchAnalytics", fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([query])
  @@map("search_analytics")
}

model File {
  id            String   @id @default(cuid())
  originalName  String
  filename      String   @unique
  path          String
  thumbnailPath String?
  size          Int
  mimeType      String
  width         Int?
  height        Int?
  type          String   @default("listing")
  uploadedById  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  listingId     String?
  source        String   @default("upload")
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById, type])
  @@index([filename])
  @@index([listingId])
  @@map("files")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SurveyResponse {
  id                     String    @id @default(cuid())
  userId                 String?
  brandId                String?
  modelId                String?
  customBrand            String?
  customModel            String?
  referenceString        String?
  batteryAutonomyRate    Int?
  delaySyncRate          Int?
  robustnessRate         Int?
  soundQualityVideo      Int?
  soundQualityMusic      Int?
  soundQualityPodcasts   Int?
  noiseReductionRate     Int?
  musicStyleMostListened String?
  musicStyleMostSuitable String?
  hasEarbudLocalization  Boolean   @default(false)
  earbudLocRate          Int?
  hasCaseLocalization    Boolean   @default(false)
  caseLocRate            Int?
  localizationType       String?
  localizationSavedLife  Boolean   @default(false)
  dateOfPurchase         DateTime?
  usageDurationMonths    Int?
  pricePaid              Decimal?  @db.Decimal(10, 2)
  locationPurchase       String?
  countryOfPurchase      String?
  countryOfUsage         String?
  lossExperienceDetails  String?
  purchasedNewKit        Boolean   @default(false)
  boughtSpareItem        Boolean   @default(false)
  spareCondition         String?
  sparePurchaseLocation  String?
  spareCountry           String?           // country where spare was bought
  sparePrice             Decimal?  @db.Decimal(10, 2)
  spareCurrency          String?           // ISO 4217 currency for spare

  // ── Device & App context ────────────────────────────────────────────────────
  deviceTypes            String?           // comma-separated: LAPTOP,MOBILE,TABLET,OTHER
  deviceTypeOther        String?           // free text if OTHER selected
  operatingSystems       String?           // comma-separated: IOS,ANDROID,WINDOWS,LINUX,MACOS,OTHER
  osOther                String?           // free text if OTHER selected
  commandOnDeviceRate    Int?              // 1-5 rating: ease of controlling earbuds from device
  deviceAppRate          Int?              // 1-5 rating: companion app quality

  // ── Resale ──────────────────────────────────────────────────────────────────
  resoldItem             Boolean   @default(false)
  resoldItemType         String?           // case | one_earbud | two_earbuds | full_kit
  resoldCondition        String?           // NEW | USED
  resoldPrice            Decimal?  @db.Decimal(10, 2)
  resoldCurrency         String?           // ISO 4217
  resoldStore            String?           // store/website

  createdAt              DateTime  @default(now())
  brand                  Brand?    @relation(fields: [brandId], references: [id])
  model                  Model?    @relation(fields: [modelId], references: [id])
  user                   User?     @relation(fields: [userId], references: [id])

  @@map("survey_responses")
}

