# Production Environment Variables for Railway
NODE_ENV=production
PORT=4000

# Database - Railway PostgreSQL
DATABASE_URL=

# Authentication & Security
JWT_SECRET=
ID_ENCRYPTION_KEY=

# CORS Configuration 
CORS_ORIGINS=

# External APIs
GEODB_BASE_URL=https://geodb-cities-api.wirefreethought.com

# PayPal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# File Storage (MinIO/S3 - Cloudflare R2)
MINIO_ENDPOINT=
MINIO_PORT=443
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=pair-me-up
MINIO_USE_SSL=true
# REQUIRED for images to display: set to your R2 public URL
# Format: https://pub-XXXX.r2.dev  OR  https://your-custom-domain.com
# Or for a custom domain on R2: https://images.yourdomain.com
MINIO_PUBLIC_URL=

# Redis Cache
REDIS_URL=

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@earbudhub.com
